{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  header {
    # Security baseline for browser clients.
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
  }

  handle_path /api/* {
    reverse_proxy backend:8000
  }

  handle /auth/* {
    reverse_proxy backend:8000
  }

  handle /health {
    reverse_proxy backend:8000
  }

  # Invoicing tool — admin-only. Every request is gated by the backend's
  # /invoicing-authz forward-auth check (200 only for admins holding
  # MANAGE_INVOICE_TEMPLATES); non-admins get the backend's 401/403 relayed back.
  redir /invoicing /invoicing/ 308
  handle_path /invoicing/* {
    forward_auth backend:8000 {
      uri /invoicing-authz
      # pass the authenticated identity through to the invoicing service so it can
      # attribute official/draft generations and gate corrections to the original author
      copy_headers X-Invoicing-User X-Invoicing-Name
    }
    reverse_proxy invoicing:8765
  }

  handle {
    reverse_proxy frontend:3000
  }
}
